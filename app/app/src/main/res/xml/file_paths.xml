<?xml version="1.0" encoding="utf-8"?>
<paths>
    <!--
      Only the exports folder is exposed. The provider must not hand out the
      whole cache: the cache also holds Compose/runtime artifacts, and a share
      target that receives a URI grants read access to exactly that path.
    -->
    <cache-path
        name="exports"
        path="exports/" />
</paths>
