<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      Declared here as well as in :app so the lint checks on this module's
      UsageStatsManager calls can see the requirement; the manifest merger
      deduplicates identical uses-permission elements. It stays a special
      access the user grants in Settings, not a runtime prompt.
    -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <application>
        <service
            android:name=".core.SoberCoreService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="dataSync|specialUse">
            <!--
              A screen-time watchdog runs whenever the device is in use, which
              outlives the six-hour daily allowance Android 15 gives dataSync.
              No other FGS type describes continuously watching the foreground
              app, so this is a genuine specialUse case (API 34+).
            -->
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Screen-time enforcement: watches the foreground app and shows the block overlay until the user's daily limit resets." />
        </service>
            
        <service
            android:name=".core.SoberNotificationService"
            android:label="Sober Notification Filter"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <service
            android:name=".core.SoberAccessibilityService"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
            android:label="Sober"
            android:exported="true">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>
    </application>
</manifest>
